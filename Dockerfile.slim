# Slim model-server image: the real vLLM Rust frontend (vllm-rs) in front of the
# vllm-vcr engine over the in-pod engine-core handshake, without UCX/libnixl. Same
# entrypoint and env contract as ./Dockerfile; the P/D KV transfer falls back to the
# control-plane-only data plane, so this image is for single-pod serving and the
# per-line kind e2e gate (ci/kind-e2e.sh), not the llm-d P/D path.
#
# The frontend and the engine must speak the same wire, so build from a context
# already pinned to the line (`cargo xtask pin-vllm <line>`) and pass that line's
# frontend source and tag (`cargo xtask frontend-args <line>`):
#
#   just image-build-slim 0.33

ARG RUST_VERSION=1.95.0

ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_REF=4ba787ec9959e566d3b587a796dff07673324da5
ARG VLLM_TARGET_VERSION=v0.33.0

# ---------------------------------------------------------------------------------------
FROM rust:${RUST_VERSION}-bookworm AS toolchain
# protoc + the well-known protos for vllm-rs's prost build, openssl headers for
# openssl-sys, cmake/clang for the C-backed -sys crates.
RUN apt-get update && apt-get install -y --no-install-recommends \
        protobuf-compiler libprotobuf-dev libssl-dev pkg-config cmake clang \
    && rm -rf /var/lib/apt/lists/*

# Keyed only on VLLM_REPO/VLLM_REF, so the layer cache holds it across sim changes.
FROM toolchain AS frontend
ARG VLLM_REPO
ARG VLLM_REF
RUN git clone --filter=blob:none "${VLLM_REPO}" /src/vllm \
    && cd /src/vllm && git checkout "${VLLM_REF}" \
    && cd rust && cargo build --release --bin vllm-rs \
    && cp target/release/vllm-rs /usr/local/bin/vllm-rs \
    && rm -rf /src/vllm

FROM toolchain AS engine
ARG VLLM_TARGET_VERSION
WORKDIR /src/vllm-vcr
COPY . .
RUN VLLM_TARGET_VERSION="${VLLM_TARGET_VERSION}" cargo build --release -p vllm-vcr \
    && cp target/release/vllm-vcr /usr/local/bin/vllm-vcr \
    && rm -rf target

# ---------------------------------------------------------------------------------------
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /usr/local/bin/vllm-rs /usr/local/bin/vllm-rs
COPY --from=engine /usr/local/bin/vllm-vcr /usr/local/bin/vllm-vcr
COPY entrypoint.sh /usr/local/bin/entrypoint.sh

ENV HF_HOME=/tmp/hf
EXPOSE 8000 8001
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
